#!/bin/sh /etc/rc.common
# BRVG phone-home hub-lite — OpenWrt/GL.iNet procd service.
# Install: copy brvg-hub-lite.sh to /usr/bin/brvg-hub-lite (chmod 755), config to /etc/brvg-hub-lite.conf
# (chmod 600), this file to /etc/init.d/brvg-hub-lite (chmod 755), then:
#   /etc/init.d/brvg-hub-lite enable && /etc/init.d/brvg-hub-lite start

START=95
USE_PROCD=1

start_service() {
    # The service's start time: `uptimeSecs` on /api/hub/status, and the 15-minute first-run window
    # /api/hub/bootstrap honours. Written on start and restart but NOT on a procd respawn, so a
    # crash loop cannot hold the setup window open forever — only a deliberate restart reopens it,
    # exactly the daemon's rule.
    date +%s > /tmp/brvg-hub-lite.started 2>/dev/null
    procd_open_instance
    procd_set_param command /usr/bin/brvg-hub-lite
    procd_set_param respawn 3600 30 0   # retry forever, 30 s apart, reset counter hourly
    procd_set_param stderr 1            # hub-lite logs go to logread
    procd_close_instance

    # A dedicated uhttpd serves BOTH CGIs on the vessel LAN:
    #   /cgi-bin/report — the relay tier's webhook receiver (HUB-PROXY.md)
    #   /cgi-bin/mgmt   — the management door (hub-lite 0.14.0)
    #
    # ⚠️ NOT GATED ON HUB_LITE_ENABLED any more (2026-08-21). That flag turns on the RELAY TIER, and
    # tying the listener to it meant a hub-lite that merely reported telemetry had no management
    # door at all — so the app fell back to driving the router VENDOR's API, which is the thing the
    # door exists to replace. The two CGIs are independently deny-by-default (the receiver does
    # nothing until webhooks are pointed at it; the management door answers 401 until the box has
    # collected its key), so serving them costs a listener and nothing else.
    #
    # Still conditional on uhttpd and /www/brvg EXISTING: uhttpd is not stock GL.iNet firmware
    # (bench X750), and the hub-lite itself must keep working without either.
    # shellcheck disable=SC1091
    [ -f /etc/brvg-hub-lite.conf ] && . /etc/brvg-hub-lite.conf
    if [ -x /usr/sbin/uhttpd ] && [ -d /www/brvg ]; then
        # ONE CONTRACT, ONE PORT (owner ruling 2026-08-31): a hub-lite answers on 8722, the same
        # port and the same /api/hub/* paths as the Rust daemon, so the app has one hub dialect
        # rather than two. `-x /api` is what makes /api/hub/<verb> reach the CGI: uhttpd resolves
        # the longest existing file path and hands the remainder over as PATH_INFO, so a single
        # script at /www/brvg/api/hub serves every verb under it.
        procd_open_instance hub_lite
        procd_set_param command /usr/sbin/uhttpd -f -h /www/brvg -x /cgi-bin -x /api -p "0.0.0.0:${RECEIVER_PORT:-8722}"
        procd_set_param respawn 3600 30 0
        procd_close_instance

        # ⚠️ THE LEGACY LISTENER IS A SAFETY REQUIREMENT, NOT POLITENESS.
        #
        # Every Shelly on an existing vessel has its webhook registered at
        # http://<router>:8181/cgi-bin/report. Moving the port without this would silently cut those
        # sensors off from the LOCAL FLOOD SHUTOFF — the one path that exists precisely because the
        # uplink is least likely to be there during a flood. The sensors are fixed-firmware and do
        # not re-register themselves; only the app can re-point them, on its own schedule.
        #
        # So 8181 keeps answering until every hook has moved. Set RECEIVER_LEGACY_PORT=0 to retire
        # it once `deviceDiagnostics` reports no sensor still pointing there.
        # ⚠️ NEVER THE SAME PORT TWICE. An install that predates the 8722 move still has
        # RECEIVER_PORT=8181 written in its conf, and the legacy default is also 8181 — starting
        # both would have two uhttpd instances binding one port, the second failing on EADDRINUSE
        # and procd respawn-looping it forever. Equal ports means the box is simply still on the
        # old port and needs no second listener at all.
        if [ "${RECEIVER_LEGACY_PORT:-8181}" != "0" ] && \
           [ "${RECEIVER_LEGACY_PORT:-8181}" != "${RECEIVER_PORT:-8722}" ]; then
            procd_open_instance hub_lite_legacy
            procd_set_param command /usr/sbin/uhttpd -f -h /www/brvg -x /cgi-bin -x /api -p "0.0.0.0:${RECEIVER_LEGACY_PORT:-8181}"
            procd_set_param respawn 3600 30 0
            procd_close_instance
        fi
    fi
}
