# BRVG phone-home hub-lite configuration. Copy to /etc/brvg-hub-lite.conf and chmod 600 — the vehicle
# key authenticates telemetry writes for this vehicle and must not be world-readable.

# The vehicle this device reports into (Settings → the vehicle's id) and this device's id in it.
VID=""
DEVICE_ID=""

# PREFERRED: the per-device token minted by POST /api/agent/enroll (admin-only; shown once).
# Individually revocable — a leaked token exposes only this device's telemetry write path.
DEVICE_TOKEN=""

# Legacy fallback when DEVICE_TOKEN is empty: the vehicle webhook key (sh_webhook_secret — the
# same k= every Shelly webhook carries). Works, but is shared vehicle-wide.
VEHICLE_KEY=""

# Hosted worker. Must be https.
WORKER_URL="https://api.dockneighbor.com"

# Cadences (seconds). Floors: GPS 30, modem 60. These ride the customer's metered link —
# every tick is one small HTTPS GET.
GPS_INTERVAL=120
MODEM_INTERVAL=600

# GPS report-by-exception. The fix is still COLLECTED and the anchor drag check RUN every
# GPS_INTERVAL; these only gate the cloud SEND to spare a metered link when parked. A fix is sent
# anyway when it moves past GPS_DEADBAND_M metres, whenever an anchor watch is armed (always), or
# once GPS_LIVENESS_SECS elapses (keeps the cloud's offline + away-watch fresh — keep it under the
# vehicle's offline threshold, default 60 min). Set GPS_DEADBAND_M=0 to disable and send every tick.
GPS_DEADBAND_M=50
GPS_LIVENESS_SECS=1200

# GPS source: auto (GL.iNet → modem AT; else gpsd if present; else NMEA serial), at, gpsd, nmea,
# tcp (NMEA over the network — chartplotter/AIS/gpsd serving on a LAN port), or cradlepoint
# (poll a Cradlepoint NCOS router's local HTTP API — the router is never configured to push).
GPS_SOURCE=auto

# For GPS_SOURCE=tcp: the LAN NMEA server to dial (the hub-lite is always the client).
GPS_HOST=""
GPS_PORT=10110

# For GPS_SOURCE=cradlepoint: the router's LAN address + admin credential (same names as the
# TypeScript hub's env, so one enrollment config drives either tier).
CRADLEPOINT_HOST=""
CRADLEPOINT_PORT=80
CRADLEPOINT_USER=admin
CRADLEPOINT_PASSWORD=""

# Modem AT port. GL-X750: /dev/ttyUSB2. X3000-class (PCIe RM520): check `ls /dev/mhi_*` — see
# hub-lite/README.md. Leave as-is on a Pi with no cellular HAT (modem telemetry is skipped).
AT_PORT=/dev/ttyUSB2

# Raw NMEA serial device for GPS_SOURCE=nmea (e.g. a u-blox USB dongle: /dev/ttyACM0).
GPS_DEVICE=""

# --- Relay (X750-class routers — HUB-PROXY.md relay tier) ---------------------------------------
# When enabled, a small LAN-only web listener (uhttpd) receives the Shellys' webhooks locally and
# this hub-lite rolls them up into ONE cloud report per interval — the metered link pays per TLS
# handshake, not per byte, so fewer connections is the whole saving. Alarms are never held: the
# receiver sends them to the cloud immediately, on their own.
HUB_LITE_ENABLED=0
# LAN port the receiver listens on (the WAN zone drops inbound by default; LAN-only regardless).
# One contract with the full hub (owner ruling 2026-08-31): same port, same /api/hub/* paths.
RECEIVER_PORT=8722
# The port existing Shelly webhooks were registered against. Kept answering so a sensor that has
# not been re-pointed still reaches the LOCAL FLOOD SHUTOFF. Set to 0 to retire it.
RECEIVER_LEGACY_PORT=8181
# Every Nth drain sends a full keyframe instead of a delta, bounding how long a lost report can
# leave the cloud's view stale.
KEYFRAME_EVERY=6

# --- LinkTap gateway (hub-only model, owner 2026-08-19) -----------------------------------------
# The LinkTap gateway on this LAN, controlled locally over HTTP — no LinkTap cloud. Same names as
# the TypeScript hub's env (LINKTAP_HOST etc.), so one enrollment config drives either tier.
# When set, a flood alarm arriving at the relay receiver closes every listed valve BEFORE the
# cloud send (works with the uplink down). Empty = feature off.
LINKTAP_HOST=""
LINKTAP_GW_ID=""
# Comma-separated 16-hex valve ids.
LINKTAP_DEV_IDS=""
# Cycle semantics on hub-lite (parity port of the hub's cycle machine): poll cadence and the
# Normal Run profile. SAME names as the TypeScript hub's env. The software volume cutoff and
# restart-only-on-timer run here on the router, so they work with the WAN down.
LINKTAP_POLL=120
LINKTAP_NORMAL_SECS=86400
LINKTAP_NORMAL_VOL_L=378
LINKTAP_AUTO_RESTART=0

# --- Bandwidth saver mode -----------------------------------------------------------------------
# When lockdown is armed to control metered-SIM spend (not merely to structure the LAN), set this
# to 1: the hub watchdog below is DISABLED and lockdown FAILS CLOSED — a dead hub means a silent
# vessel until the connectivity-offline alert fires, which is the accepted trade. Also the mode
# where a management tunnel must stay off. 0 = normal: the watchdog (if configured) fails open.
BANDWIDTH_SAVER=0

# --- Hub watchdog (fail open — unless BANDWIDTH_SAVER=1 above) ----------------------------------
# Only for a hub running on a SEPARATE box (a Pi, Docker, the desktop app). When the hub runs on
# this router the failure domains already coincide and this is pointless.
#
# Under a "traffic" lockdown the hub is the only path to the cloud, so if it dies the vehicle goes
# silent. The router watches its health endpoint and, after HUB_WATCH_FAILS consecutive failures,
# RELEASES the lockdown rules so reporting resumes — and tells you it did. It does NOT re-arm on
# recovery (a flapping hub would thrash the firewall); re-apply from the app when you're ready.
HUB_WATCH_URL=""            # e.g. http://192.168.8.50:8181/healthz — empty disables the watchdog
HUB_WATCH_FAILS=5           # consecutive failed checks before failing open (one check per modem tick)
